# Copy to .env for local development. Never commit a filled-in copy.
# Every variable is prefixed LEDGERLINE_ and parsed by app/core/config.py.

LEDGERLINE_ENVIRONMENT=local
LEDGERLINE_DEBUG=false
LEDGERLINE_LOG_LEVEL=INFO
# Human-readable console logs locally; JSON everywhere else.
LEDGERLINE_LOG_JSON=false

# --- Persistence -----------------------------------------------------------------
LEDGERLINE_DATABASE_URL=postgresql+asyncpg://ledgerline:ledgerline@localhost:5432/ledgerline
LEDGERLINE_REDIS_URL=redis://localhost:6379/0

# --- HTTP ------------------------------------------------------------------------
LEDGERLINE_CORS_ORIGINS=http://localhost:3000

# --- Authentication (Clerk) ------------------------------------------------------
# Found under Clerk dashboard → API keys → "Show JWT public key" / Frontend API URL.
LEDGERLINE_CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
LEDGERLINE_CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Only set when your Clerk JWT template defines an audience.
# LEDGERLINE_CLERK_AUDIENCE=

# Local-only: accept an `X-Debug-User: <clerk id>` header instead of a real token.
# The application refuses to start if this is true while ENVIRONMENT=production.
LEDGERLINE_AUTH_DEV_BYPASS=true

# --- Object storage --------------------------------------------------------------
LEDGERLINE_S3_BUCKET=ledgerline-media
LEDGERLINE_S3_REGION=us-east-1
# Set for MinIO or another S3-compatible endpoint; leave unset for AWS.
# LEDGERLINE_S3_ENDPOINT_URL=http://localhost:9000

# --- Tests -----------------------------------------------------------------------
# Database-backed tests are skipped unless this points at a migrated database.
# LEDGERLINE_TEST_DATABASE_URL=postgresql+asyncpg://ledgerline:ledgerline@localhost:5432/ledgerline
